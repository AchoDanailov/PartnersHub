# Local-only secrets for the Edge Functions. Copy this file to .env (ignored by
# Git); `npx supabase functions serve` and .github/scripts/serve-functions.sh
# load it. CI uses these values as they are.
#
# These values are for the local stack only. A hosted project gets its own
# through `supabase secrets set`, never these.

# issue-voucher: the secret a caller sends in the X-Voucher-Issuer-Secret header.
VOUCHER_ISSUER_SECRET=local-only-voucher-issuer-secret-do-not-deploy
# issue-voucher: base URL of the web app that voucher QR codes point at.
WEB_APP_URL=http://localhost:5173
